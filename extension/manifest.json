{
  "manifest_version": 3,
  "name": "Topic Master — PYQ Screenshot Importer",
  "version": "1.0.0",
  "description": "Sequential webpage screenshot capture and importer for GATE PYQs organized by subject.",
  "permissions": [
    "tabs",
    "activeTab",
    "storage",
    "unlimitedStorage",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "PYQ Screenshot Importer"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ]
}
